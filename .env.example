# Railway Production: valores de ejemplo, nunca subir credenciales reales.
NODE_ENV=production
APP_URL=https://senzoly.com
FRONTEND_URL=https://senzoly.com
EMAIL_FROM=Senzoly <hola@senzoly.com>
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=generate-a-long-random-secret
RESEND_API_KEY=re_xxxxxxxxx
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
SUPER_ADMIN_EMAIL=admin@senzoly.com
SUPER_ADMIN_PASSWORD_HASH=$2b$10$replace-with-a-bcrypt-hash
